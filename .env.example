# ──────────────────────────────────────────────────────────────
# CozyBox environment configuration
# Copy to `.env` (root) — values are read by the server workspace.
# ──────────────────────────────────────────────────────────────

# Server
PORT=4000
# Comma-separated list of allowed CORS origins for the web app
WEB_ORIGIN=http://localhost:5173

# ──────────────────────────────────────────────────────────────
# Square integration
#
# Leave SQUARE_ACCESS_TOKEN empty to run in MOCK mode. In mock mode the
# server serves seeded CozyBox catalog/booking/loyalty data from memory,
# so the whole app runs end-to-end with no external credentials.
#
# To use real Square (Sandbox or Production), set the values below.
# Get sandbox credentials at https://developer.squareup.com/apps
# ──────────────────────────────────────────────────────────────
SQUARE_ACCESS_TOKEN=
# "sandbox" or "production"
SQUARE_ENVIRONMENT=sandbox
# Default location used for orders/bookings/loyalty (from Square dashboard)
SQUARE_LOCATION_ID=

# Web app (Vite) — exposed to the browser, so only public values here.
# Square Web Payments SDK application id + location for card tokenisation.
VITE_API_BASE=http://localhost:4000
VITE_SQUARE_APP_ID=
VITE_SQUARE_LOCATION_ID=
