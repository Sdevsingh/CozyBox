# ──────────────────────────────────────────────────────────────
# CozyBox environment configuration
#
# The app has two workspaces:
#   • backend/  (FastAPI)  → copy the BACKEND block into backend/.env
#   • frontend/ (CRA)      → copy the FRONTEND block into frontend/.env
#
# The frontend needs NO Square secrets — it fetches the public Square
# ids (applicationId, locationId) from the backend at GET /api/config.
# ──────────────────────────────────────────────────────────────


# ========== backend/.env ==========

# MongoDB is optional. Leave MONGO_URL blank to use the in-memory store.
# MONGO_URL=mongodb://localhost:27017
# DB_NAME=cozybox

# ── Square (Sandbox) ──────────────────────────────────────
# Leave SQUARE_ACCESS_TOKEN blank to run in MOCK mode (no external calls).
# Get sandbox values at https://developer.squareup.com/apps → your app → Sandbox.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=          # Sandbox → Credentials → "Sandbox Access token"
SQUARE_APPLICATION_ID=        # Sandbox → Credentials → "Sandbox Application ID" (sandbox-sq0idb-…)
SQUARE_LOCATION_ID=           # Sandbox → Locations (L…) or via the MCP / Locations API
SQUARE_CURRENCY=AUD

# ── Square Bookings (Appointments) — only needed for live table bookings ──
SQUARE_SERVICE_VARIATION_ID=      # the bookable "table reservation" service variation
SQUARE_SERVICE_VARIATION_VERSION= # that variation's version number
SQUARE_TEAM_MEMBER_ID=            # a bookable team member (TM…)

# Which Square category NAMES appear in the Cellar shop (retail bottles).
# In production, leave blank to keep the curated static list; set to your
# "Take Home Bottles" category once it's built in Square (with prices + images).
SQUARE_RETAIL_CATEGORIES=

# ── Transactional email (Resend — recommended) ───────────
# Set RESEND_API_KEY to enable branded confirmation emails, an .ics calendar
# invite, AND scheduled booking reminders (Resend `scheduled_at`). Create a key
# at https://resend.com → API Keys, and verify the cozybox.au domain (DNS) so
# MAIL_FROM can send from it. Leave blank to fall back to SMTP or no-op.
RESEND_API_KEY=            # re_xxxxxxxx
BOOKING_REMINDER_HOURS=3   # send the reminder this many hours before the booking
BOOKING_DURATION_MIN=90    # length used for the .ics calendar invite
# VENUE_TZ=Australia/Melbourne

# ── Email (SMTP fallback, optional) ───────────────────────
# Used only if RESEND_API_KEY is blank. Reminders are NOT sent over SMTP
# (no native scheduling). Until either provider is set, sends are a safe no-op.
SMTP_HOST=            # e.g. smtp.sendgrid.net / your provider
SMTP_PORT=587
SMTP_USER=            # SMTP username / API user
SMTP_PASS=            # SMTP password / API key
MAIL_FROM=hello@cozybox.au        # must be on the domain you verify in Resend
MAIL_FROM_NAME=Cozy Box by Fossey's
MAIL_BCC=hello@cozybox.au          # venue copy of every email (booking tracking)
MAIL_REPLY_TO=hello@cozybox.au     # where customer replies land
# During testing, point BCC + REPLY_TO at your own inbox, then switch both to
# hello@cozybox.au for launch:
#   MAIL_BCC=you@gmail.com
#   MAIL_REPLY_TO=you@gmail.com

# ── Scheduled tasks ───────────────────────────────────────
# Secret guarding POST /api/tasks/schedule-reminders (the daily reminder sweep
# for bookings made >72h out). Set a random string; pass it as ?key= from cron.
TASKS_SECRET=


# ========== frontend/.env ==========

# Points the CRA app at the local backend (Square proxy). Use 127.0.0.1
# (not localhost) to avoid the IPv6 Node server that sits on :4000.
REACT_APP_BACKEND_URL=http://127.0.0.1:4040


# ──────────────────────────────────────────────────────────────
# Production / domain (fill when deploying)
# ──────────────────────────────────────────────────────────────
# Backend (Railway service env):
# SQUARE_ENVIRONMENT=production
# SQUARE_ACCESS_TOKEN=<production token>
# MONGO_URL=<Railway MongoDB or Atlas SRV URL>   # required so bookings persist
# ALLOWED_ORIGINS=https://cozybox.au,https://www.cozybox.au
# RESEND_API_KEY=re_live_xxxx
# TASKS_SECRET=<random string>
#
# Frontend (build-time env):
# REACT_APP_BACKEND_URL=https://api.cozybox.au
